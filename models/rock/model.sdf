<?xml version="1.0"?>
<sdf version="1.10">
  <model name="mars_rock">
    <static>true</static>

    <link name="rock_link">

      <!-- Main boulder -->
      <collision name="main_collision">
        <geometry>
          <sphere>
            <radius>0.7</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="main_visual">
        <geometry>
          <sphere>
            <radius>0.7</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.32 0.19 0.12 1</ambient>
          <diffuse>0.48 0.27 0.16 1</diffuse>
        </material>
      </visual>

      <!-- Smaller irregular sections -->
      <visual name="rock_extension_1">
        <pose>0.45 0.05 0.05 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.42</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.32 0.19 0.12 1</ambient>
          <diffuse>0.48 0.27 0.16 1</diffuse>
        </material>
      </visual>

      <visual name="rock_extension_2">
        <pose>-0.35 0.12 0.15 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.38</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.32 0.19 0.12 1</ambient>
          <diffuse>0.48 0.27 0.16 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
